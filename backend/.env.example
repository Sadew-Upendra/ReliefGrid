# Copy to .env (git-ignored) or export these before running the app.
DB_URL=jdbc:postgresql://localhost:5432/reliefgrid
DB_USER=reliefgrid
DB_PASSWORD=dbpassword123

# Generate with: openssl rand -base64 48   (must be 32+ chars)
JWT_SECRET=replace-with-a-long-random-value

CORS_ORIGINS=http://localhost:3000

# Set only when the database has no admin yet; leave both blank after first boot.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Point at infra/kafka's local broker, or leave as-is if you don't need Kafka running.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Leave SMTP_HOST blank to have notifications just log instead of sending real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATIONS_FROM_ADDRESS=no-reply@reliefgrid.local
