# Shared version constraints, symlinked-by-copy into each environment
# (Terraform has no native "include" — see environments/*/versions.tf).
terraform {
  required_version = ">= 1.9"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.70"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}
