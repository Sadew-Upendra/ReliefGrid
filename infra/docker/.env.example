# Copy to infra/docker/.env and fill in before running docker compose.
DB_NAME=reliefgrid
DB_USER=reliefgrid
DB_PASSWORD=dbpassword123

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Set once to create the first admin account; then blank these out again.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Only used if infra/kafka/docker-compose.kafka.yml is also running.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
